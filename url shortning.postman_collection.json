              "script": {
                "exec": [
                  "const responseJson = pm.response.json();\r",
                  "\r",
                  "if (responseJson.token) {\r",
                  "    console.log(\"SUCCESS! Found token:\", responseJson.token);\r",
                  "    \r",
                  "    // Try setting it as both an environment AND global variable to be safe\r",
                  "    pm.environment.set(\"bearer_token\", responseJson.token);\r",
                  "    pm.globals.set(\"bearer_token\", responseJson.token);\r",
                  "    \r",
                  "} else {\r",
                  "    console.warn(\"Token not found in response body.\");\r",
